# Staging environment for the plain docker-compose.yml stack (no Caddy/
# public domain — that's the production-only path via docker-compose.public.yml
# / docker-compose.aws.yml). Use this to test DAG/code changes before they
# reach the production .env on the deploy server.
#
# Usage:
#   cp .env.staging.example .env.staging   # then fill in real values below
#   docker compose --env-file .env.staging -p returns-staging up -d
#
# -p returns-staging gives this stack its own container names, network, and
# Postgres volume — Compose namespaces everything by project name, so it
# cannot collide with (or accidentally read/write) whatever is running under
# the default project name from `docker compose up -d` with the plain .env.
#
# ENV_FILE must be set to this file's own name — docker-compose.yml resolves
# `env_file: ${ENV_FILE:-.env}` per service, so this is what actually makes
# the containers load staging config instead of production's .env.
ENV_FILE=.env.staging

# Host ports. Only need to differ from the defaults (5444/8080) if you want
# to run this staging stack and the default one at the same time on the same
# machine; otherwise the defaults are fine since -p already isolates them.
POSTGRES_HOST_PORT=5445
AIRFLOW_WEBSERVER_PORT=8081

# Airflow admin
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD_FILE=/opt/airflow/secrets/airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow secrets
AIRFLOW__CORE__FERNET_KEY_FILE=/opt/airflow/secrets/airflow_fernet_key
AIRFLOW__WEBSERVER__SECRET_KEY_FILE=/opt/airflow/secrets/airflow_webserver_secret_key

# Source controls
SPX_API_SOURCE_ENABLED=true
EVERPRO_API_SOURCE_ENABLED=true
MENGANTAR_API_SOURCE_ENABLED=true
RETURNS_FETCH_START_DATE=
RETURNS_FETCH_END_DATE=

# SPX API source (secrets loaded from files)
SPX_API_SPX_TOKEN_FILE=/opt/airflow/data/session/spx_token
SPX_API_SPX_SID_FILE=/opt/airflow/data/session/spx_sid
SPX_API_PAGE_SIZE=100
SPX_API_TIMEOUT_SECONDS=60

SPX_WEB_LOGIN_ENABLED=false
SPX_WEB_USERNAME_FILE=/opt/airflow/secrets/spx_web_username
SPX_WEB_PASSWORD_FILE=/opt/airflow/secrets/spx_web_password

# Everpro API source (secrets loaded from files)
EVERPRO_API_BASE_URL=https://customer.everpro.id
EVERPRO_API_TOKEN_FILE=/opt/airflow/secrets/everpro_api_token
EVERPRO_REFRESH_TOKEN_FILE=/opt/airflow/secrets/everpro_refresh_token
EVERPRO_API_LIMIT=100

# Mengantar API source (secrets loaded from files)
MENGANTAR_API_FILE=/opt/airflow/data/session/mengantar_api
MENGANTAR_WEB_LOGIN_ENABLED=false
MENGANTAR_WEB_EMAIL_FILE=/opt/airflow/secrets/mengantar_web_email
MENGANTAR_WEB_PASSWORD_FILE=/opt/airflow/secrets/mengantar_web_password
MENGANTAR_API_COURIER=all
MENGANTAR_API_PLAN=Standart JNE
MENGANTAR_API_PAGE_SIZE=50
MENGANTAR_API_TIMEOUT_SECONDS=60

# API paging and retry
API_MAX_PAGES=50
API_RATE_SLEEP=1.5
API_MAX_RETRIES=5
API_NETWORK_MAX_RETRIES=8
API_FATAL_ON_5XX=false

# Data quality validation
VALIDATION_MIN_STAGING_ROWS=10
VALIDATION_MIN_ELIGIBLE_ROWS=1
VALIDATION_MAX_SPX_NO_VALUE_RATIO=0.20

# Alerting
# Point this at a separate staging Slack channel/webhook so staging failures
# don't page whoever watches the production alert channel.
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Database
# Same Postgres credentials as production are fine (there's no separate
# vendor sandbox to point at) — what actually isolates staging data is a
# distinct DB_NAME, so a bad staging run can never touch production tables.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=returns_db_staging
DB_USER=admin
DB_PASSWORD_FILE=/opt/airflow/secrets/db_password
