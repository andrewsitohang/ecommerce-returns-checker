{$PUBLIC_DOMAIN} {
    reverse_proxy airflow-webserver:8080
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }
}

{$METABASE_PUBLIC_DOMAIN} {
    reverse_proxy {$METABASE_HOST}
    encode gzip
}
