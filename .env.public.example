# Public domains
PUBLIC_DOMAIN=airflow.example.com
AIRFLOW_PUBLIC_BASE_URL=https://airflow.example.com
METABASE_PUBLIC_DOMAIN=metabase.example.com
METABASE_PUBLIC_BASE_URL=https://metabase.example.com

# Metabase
METABASE_DB_HOST=postgres
METABASE_DB_PORT=5432
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=CHANGE_ME_METABASE_DB_PASSWORD
METABASE_ENCRYPTION_SECRET_KEY=CHANGE_ME_METABASE_SECRET

# Airflow admin
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow secrets
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_FERNET_KEY
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_WEBSERVER_SECRET

# Source controls
SPX_API_SOURCE_ENABLED=true
EVERPRO_API_SOURCE_ENABLED=true
RETURNS_FETCH_START_DATE=
RETURNS_FETCH_END_DATE=

# SPX API source
SPX_API_SPX_TOKEN=
SPX_API_SPX_SID=
SPX_API_PAGE_SIZE=100
SPX_API_TIMEOUT_SECONDS=60

# Everpro API source
EVERPRO_API_BASE_URL=https://customer.everpro.id
EVERPRO_API_TOKEN=
EVERPRO_REFRESH_TOKEN=
EVERPRO_API_LIMIT=100

# API paging and retry
API_MAX_PAGES=50
API_RATE_SLEEP=1.0
API_MAX_RETRIES=5
API_NETWORK_MAX_RETRIES=8
API_FATAL_ON_5XX=false

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=returns_db
DB_USER=admin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
